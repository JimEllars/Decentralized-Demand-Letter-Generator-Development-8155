{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "demand-letter-generator-app-v1-axim",
  "compatibility_date": "2025-09-27",
  "observability": {
    "enabled": true
  },
  "main": "worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
    "kv_namespaces": [
    {
      "binding": "TELEMETRY_KV",
      "id": "e63b6528751543fc95e69e0ee2546dbf",
      "preview_id": "e63b6528751543fc95e69e0ee2546dbf"
    }
  ],
  "vars": {
    "BACKEND_URL": "https://axim-payment-backend.jrellars.workers.dev"
  }
}