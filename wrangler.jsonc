{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "demand-letter-generator-app-v1-axim",
  "compatibility_date": "2025-09-27",
  "observability": {
    "enabled": true
  },
  "main": "worker.js",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],

  "kv_namespaces": [
    {
      "binding": "TELEMETRY_KV",
      "id": "REPLACE_WITH_TELEMETRY_KV_ID",
      "preview_id": "REPLACE_WITH_PREVIEW_KV_ID"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "BACKEND_URL": "https://axim-payment-backend.jrellars.workers.dev"
  }
}
