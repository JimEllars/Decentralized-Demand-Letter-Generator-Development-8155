{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "demand-letter-generator-app-v1-axim",
  "compatibility_date": "2025-09-27",
  "observability": {
    "enabled": true
  },
  "main": "worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "BACKEND_URL": "https://axim-payment-backend.jrellars.workers.dev"
  }
}